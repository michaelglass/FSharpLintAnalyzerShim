<?xml version="1.0" encoding="utf-8"?>
<!-- Code-coverage settings for `dotnet test ... -\-coverage` (Microsoft Testing
     Platform / dotnet-coverage). Scopes coverage INSTRUMENTATION to shim-owned
     code: paket-files/ holds the vendored FSharpLint git dependency, which is
     third-party code this repo neither owns nor tests directly. Excluding its
     module keeps the cobertura report (and the coverage ratchet) scoped to files
     this repo is responsible for even when SourceLink maps vendored sources back
     to their original checkout paths. -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Exclude>
        <ModulePath>.*FSharpLint[.]Core[.]dll$</ModulePath>
      </Exclude>
    </ModulePaths>
  </CodeCoverage>
</Configuration>
